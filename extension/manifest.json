{
  "manifest_version": 3,
  "name": "Registration Sniper \u2014 CRN Side Panel",
  "version": "0.7.0",
  "description": "Load prepared CRNs from the website or local app into a persistent side panel. Autofill supports the bundled mock form only.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://sabanci-registration-sniper.sitegap-tools.workers.dev/*"
  ],
  "action": {
    "default_title": "Registration Sniper"
  },
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
