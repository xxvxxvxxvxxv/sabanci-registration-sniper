{
  "manifest_version": 3,
  "name": "Registration Sniper \u2014 CRN Side Panel",
  "version": "0.8.0",
  "description": "Load prepared CRNs into a side panel; preview, fill and verify recognized SUIS registration fields. Manual submission only.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://sabanci-registration-sniper.sitegap-tools.workers.dev/*",
    "https://suis.sabanciuniv.edu/*"
  ],
  "action": {
    "default_title": "Registration Sniper"
  },
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
